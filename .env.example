# Copy to .env and fill in. Every variable without a default is mandatory —
# the process refuses to start otherwise.

# ─── Vapi intake ─────────────────────────────────────────────────────────────

# Shared secret configured on the Vapi server URL (sent as x-vapi-secret).
VAPI_WEBHOOK_SECRET=dev-secret-change-me

# shared_secret (default) | hmac_sha256
VAPI_SIGNATURE_MODE=shared_secret

# ─── General ─────────────────────────────────────────────────────────────────

# Where owner notifications go, E.164.
OWNER_PHONE=+41790000000

# Default: ./data/recovery.sqlite
DATABASE_PATH=./data/recovery.sqlite

# Default: 3000
PORT=3000

# IANA time zone used for times in the owner notification. Default: Europe/Zurich
TIMEZONE=Europe/Zurich

# ─── WhatsApp ────────────────────────────────────────────────────────────────

# stub (default, logs to console) | twilio | meta_cloud (not implemented)
WHATSAPP_PROVIDER=stub

# Required only when WHATSAPP_PROVIDER=twilio. All of them are validated at
# startup, so a missing or mistyped value stops the process instead of failing
# on the first customer.
#
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+41445556677
#
# Content SIDs from the Twilio Content Template Builder, one per message.
# See README for the German template texts to submit for approval.
# TWILIO_CONTENT_SID_CUSTOMER_MISSED_CALL=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_CONTENT_SID_CUSTOMER_INCOMPLETE_ORDER=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_CONTENT_SID_OWNER_LOST_ORDER=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_CONTENT_SID_OWNER_UNDELIVERABLE=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
